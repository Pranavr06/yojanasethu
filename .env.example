# ========================================================
# YojanaSethu Environment Configuration (.env.example)
# Team: Team Neural Forge | Nexathon 2026
# Copy this file to .env.local and add your real keys.
# ========================================================

# --------------------------------------------------------
# 1. Supabase PostgreSQL & Storage Configuration
# Find these in Supabase Dashboard -> Project Settings -> API
# --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key...

# Supabase Service Role Key (Server-side admin operations only)
# DO NOT expose with NEXT_PUBLIC prefix!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Storage Bucket for Resumes & Certificates
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=documents

# --------------------------------------------------------
# 2. AI Intelligence Engine (Gemini / LLM API)
# Used for resume skill extraction and roadmap generation
# --------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------------------
# 3. Application URL (Localhost for dev, Vercel for prod)
# --------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
